{
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "ingest/faqs-*.json"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests; default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://qjajoayybuvxvpgysoih.supabase.co https://api.sarvam.ai wss://raymidi-voice-relay.onrender.com; img-src 'self' data:; frame-ancestors 'none'; media-src 'self' blob:"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)",      "dest": "/api/$1" },
    { "src": "/sw.js",         "dest": "/sw.js" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/icons/(.*)",    "dest": "/icons/$1" },
    { "src": "/ingest/(.*)",   "dest": "/ingest/$1" },
    { "src": "/ev-poc",        "dest": "/api/guard?page=ev-poc" },
    { "src": "/voice-pod",     "dest": "/api/guard?page=voice-pod" },
    { "src": "/admin",         "dest": "/api/guard?page=admin" },
    { "src": "/ingest",        "dest": "/ingest.html" },
    { "src": "/login",         "dest": "/login.html" },
    { "src": "/(.*)",          "dest": "/index.html" }
  ]
}
