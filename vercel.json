{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "ingest/faqs.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co; img-src 'self' data:; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)",      "dest": "/api/$1" },
    { "src": "/sw.js",         "dest": "/sw.js" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/icons/(.*)",    "dest": "/icons/$1" },
    { "src": "/ingest/(.*)",   "dest": "/ingest/$1" },
    { "src": "/ev-poc",        "dest": "/ev-poc.html" },
    { "src": "/ingest",        "dest": "/ingest.html" },
    { "src": "/login",         "dest": "/login.html" },
    { "src": "/admin",         "dest": "/admin.html" },
    { "src": "/(.*)",          "dest": "/index.html" }
  ]
}