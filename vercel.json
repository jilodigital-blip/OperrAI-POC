{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/ev-poc", "dest": "/ev-poc.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
